rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHost(roomId) {
      return isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    // --- ROOMS ---
    match /rooms/{roomId} {
      function isValidRoom(data) {
        return data.roomCode is string && data.roomCode.size() == 4 &&
               data.status is string && data.status in ['waiting', 'voting', 'creating', 'presenting', 'awarding', 'finale'] &&
               isValidId(data.hostId) &&
               (data.get('selectedPrompt', '') is string) &&
               (data.get('currentPrizeIndex', 0) is int) &&
               (data.get('prizes', []) is list);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      isValidRoom(incoming()) &&
                      incoming().hostId == request.auth.uid &&
                      incoming().createdAt == request.time &&
                      incoming().keys().hasAll(['roomCode', 'status', 'hostId', 'createdAt']);

      allow update: if isSignedIn() && (
        // Host has full control over state transitions and prompt selection
        (existing().hostId == request.auth.uid && isValidRoom(incoming())) ||
        // Players might update presentingPlayerId or other shared state if needed
        (isValidRoom(incoming()) && incoming().diff(existing()).affectedKeys().hasAny(['status', 'presentingPlayerId', 'selectedPrompt', 'prizes', 'currentPrizeIndex']))
      );
    }

    // --- PLAYERS ---
    match /rooms/{roomId}/players/{playerId} {
      function isValidPlayer(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
               (!('isReady' in data) || data.isReady is bool) &&
               (!('vote' in data) || data.vote is string) &&
               (!('status' in data) || data.status is string) &&
               (!('avatar' in data) || data.avatar is string) &&
               (!('votes' in data) || data.votes is map);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      isValidId(roomId) &&
                      playerId == request.auth.uid &&
                      isValidPlayer(incoming()) &&
                      incoming().keys().hasAll(['name', 'isReady', 'joinedAt', 'avatar']);

      allow update: if isSignedIn() && (
        // Self update
        (playerId == request.auth.uid && isValidPlayer(incoming()) && (
          // Allow updating common fields. joinedAt is included as setDoc often resends it.
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isReady', 'vote', 'status', 'avatar', 'joinedAt', 'votes'])
        )) ||
        // Host update
        isHost(roomId)
      );

      allow delete: if isSignedIn() && (playerId == request.auth.uid || isHost(roomId));
    }

    // --- SOLUTIONS ---
    match /rooms/{roomId}/solutions/{playerId} {
      function isValidSolution(data) {
        return data.playerId is string &&
               data.name is string && data.name.size() <= 256 &&
               data.canvasData is string && data.canvasData.size() <= 2097152; // 2MB limit
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      playerId == request.auth.uid &&
                      isValidSolution(incoming()) &&
                      incoming().keys().hasAll(['playerId', 'name', 'canvasData', 'createdAt']);

      allow update: if isSignedIn() && (
        // Self update
        (playerId == request.auth.uid && isValidSolution(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'canvasData'])) ||
        // Peer or Host update for awards (only allowed to update the prize or prizes)
        (incoming().diff(existing()).affectedKeys().hasOnly(['prize']) && 
         incoming().prize.id is string && incoming().prize.name is string) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['prizes']) && 
         incoming().prizes is list)
      );
    }
  }
}
