rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHost(roomId) {
      return isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    // --- ROOMS ---
    match /rooms/{roomId} {
      function isValidRoom(data) {
        return data.roomCode is string && data.roomCode.size() == 4 &&
               data.status is string && data.status in ['waiting', 'voting', 'creating', 'presenting', 'awarding', 'finale'] &&
               isValidId(data.hostId) &&
               (data.get('selectedPrompt', '') is string) &&
               (data.get('presentingPlayerId', '') is string);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      isValidRoom(incoming()) &&
                      incoming().hostId == request.auth.uid &&
                      incoming().createdAt == request.time &&
                      incoming().keys().hasAll(['roomCode', 'status', 'hostId', 'createdAt']) &&
                      incoming().keys().size() == 4;

      allow update: if isSignedIn() && (
        // Host has full control over state transitions and prompt selection
        (existing().hostId == request.auth.uid && isValidRoom(incoming())) ||
        // Players might need to read but not update directly usually, 
        // however some logic might trigger state changes if needed.
        // Currently only host updates room status.
        false
      );
    }

    // --- PLAYERS ---
    match /rooms/{roomId}/players/{playerId} {
      function isValidPlayer(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 32 &&
               (data.get('isReady', false) is bool) &&
               (data.get('vote', '') is string) &&
               (data.get('status', '') is string) &&
               (data.get('avatar', '') is string);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      isValidId(roomId) &&
                      playerId == request.auth.uid &&
                      isValidPlayer(incoming()) &&
                      incoming().keys().hasAll(['name', 'isReady', 'joinedAt', 'avatar']) &&
                      incoming().keys().size() == 4 &&
                      incoming().joinedAt == request.time;

      allow update: if isSignedIn() && (
        // Self update
        (playerId == request.auth.uid && isValidPlayer(incoming()) && (
          // Allow updating name, isReady, vote, status, avatar
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isReady', 'vote', 'status', 'avatar'])
        )) ||
        // Host update (e.g. kicking or forced status changes if app had it)
        isHost(roomId)
      );

      allow delete: if isSignedIn() && (playerId == request.auth.uid || isHost(roomId));
    }

    // --- SOLUTIONS ---
    match /rooms/{roomId}/solutions/{playerId} {
      function isValidSolution(data) {
        return data.playerId is string && data.playerId == playerId &&
               data.name is string && data.name.size() <= 128 &&
               data.canvasData is string && data.canvasData.size() <= 1048576; // 1MB limit check
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      playerId == request.auth.uid &&
                      isValidSolution(incoming()) &&
                      incoming().keys().hasAll(['playerId', 'name', 'canvasData', 'createdAt']);

      allow update: if isSignedIn() && (
        // Self update
        (playerId == request.auth.uid && isValidSolution(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'canvasData'])) ||
        // Peer update for awards (only allowed to update the prize)
        (incoming().diff(existing()).affectedKeys().hasOnly(['prize']) && 
         incoming().prize.id is string && incoming().prize.name is string)
      );
    }
  }
}
