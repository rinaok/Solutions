rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHost(roomId) {
      return isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    // --- ROOMS ---
    match /rooms/{roomId} {
      function isValidRoom(data) {
        return data.roomCode is string && data.roomCode.size() == 4 &&
               data.status is string && data.status in ['waiting', 'voting', 'creating', 'presenting', 'awarding', 'finale'] &&
               isValidId(data.hostId) &&
               (!('selectedPrompt' in data) || data.selectedPrompt is string) &&
               (!('currentPrizeIndex' in data) || data.currentPrizeIndex is int || data.currentPrizeIndex is float) &&
               (!('prizes' in data) || data.prizes is list) &&
               (!('presentingPlayerId' in data) || data.presentingPlayerId is string) &&
               (!('createdAt' in data) || data.createdAt is timestamp) &&
               (!('timerStartedAt' in data) || data.timerStartedAt is timestamp);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      isValidRoom(incoming()) &&
                      incoming().hostId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Only the host ever updates the room, and the result must remain a valid room
        existing().hostId == request.auth.uid && isValidRoom(incoming())
      );
    }

    // --- PLAYERS ---
    match /rooms/{roomId}/players/{playerId} {
      function isValidPlayer(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
               (!('isReady' in data) || data.isReady is bool) &&
               (!('vote' in data) || data.vote is string) &&
               (!('status' in data) || data.status is string) &&
               (!('avatar' in data) || data.avatar is string) &&
               (!('joinedAt' in data) || data.joinedAt is timestamp) &&
               (!('votes' in data) || data.votes is map);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      playerId == request.auth.uid &&
                      isValidPlayer(incoming());

      allow update: if isSignedIn() && (
        // Self update
        (playerId == request.auth.uid && isValidPlayer(incoming())) ||
        // Host update
        isHost(roomId)
      );

      allow delete: if isSignedIn() && (playerId == request.auth.uid || isHost(roomId));
    }

    // --- SOLUTIONS ---
    match /rooms/{roomId}/solutions/{playerId} {
      function isValidSolution(data) {
        return data.playerId is string &&
               data.name is string && data.name.size() <= 256 &&
               data.canvasData is string && data.canvasData.size() <= 2097152 && // 2MB limit
               (!('createdAt' in data) || data.createdAt is timestamp) &&
               (!('prize' in data) || data.prize is map) &&
               (!('prizes' in data) || data.prizes is list);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      playerId == request.auth.uid &&
                      isValidSolution(incoming());

      allow update: if isSignedIn() && (
        // Self update
        (playerId == request.auth.uid && isValidSolution(incoming())) ||
        // Peer or Host update for awards / prizes
        isValidSolution(incoming())
      );
    }
  }
}
